### .env.example (remove .example and fill in the desired/required fields)
## Env schema version. Managed by the bot (config.migrate_env) — do not edit.
## Kept in lock-step with the database version (this V2.0 release = 2).
ENV_VERSION = 2
## --- Testing (run a SEPARATE bot app/token pointed at a test guild + test Odoo DB) ---
## Set true only on the test bot. Enables test-helper commands, instant guild-scoped
## commands, and a separate timetracker.test db. Guards destructive test commands.
TESTING = false
## The test Discord server id (used for instant command sync + as a safety guard).
TESTING_GUILD_ID =
## Optional: your production guild id.
PRIMARY_GUILD_ID =
# Required Discord Bot configuration
BOT_TOKEN =
BOT_CLIENT_ID = 
BOT_CLIENT_SECRET = 
## General / infra / webhook log channel — Discord logs mirror here.
BOT_LOG_ID =
ENABLE_FUNCTIONALITY =
ENABLE_FUN =
ENABLE_TIMETRACKING =
WEBHOOK_PORT = 8080
## Shared secret token for the inbound webhook. AUTO-GENERATED on first startup if blank.
## Put it in your Odoo automation URLs as ?token=<value>. Rotate with /regenwebhooktoken.
WEBHOOK_TOKEN =
## Optional defense-in-depth: only accept webhooks from these IPs (comma-separated).
## Auto-refreshed with the Odoo host's IP(s) each time the bot calls Odoo. Toggle with /webhookallowlist.
WEBHOOK_IP_ALLOWLIST =
WEBHOOK_IP_ALLOWLIST_ENABLED = false
## Timezone used to record/interpret punch times (IANA name). Defaults to America/Chicago.
TIMEZONE = America/Chicago
## --- Logging (console + rotating file + Discord channel) ---
## Minimum SEVERITY mirrored to the Discord log channel (BOT_LOG_ID / TIMECARD_LOG_ID).
## Order low->high: DEBUG < INFO < WARNING < ERROR. The level you pick, plus everything
## ABOVE it, is posted; anything below is hidden. e.g. INFO = info+warnings+errors (debug
## hidden); WARNING = only warnings+errors (quietest useful setting).
## This affects DISCORD ONLY. The console + rotating file verbosity is a SEPARATE knob set
## by DEBUGGING below (DEBUGGING set = DEBUG-verbose console/file; empty = INFO).
LOG_DISCORD_LEVEL = INFO
## Rotating log file path + size cap. Old logs roll to bot.log.1 .. .N (bounded total size).
LOG_FILE = logs/bot.log
LOG_MAX_BYTES = 5242880
LOG_BACKUP_COUNT = 5
## Odoo integration configuration for timecard system.
####This will allow for customers and jobs to be synced with the db and for attaching work time to jobs.
####Leave blank to run fully offline; the bot works without Odoo and queues changes until it is configured.
ODOO_API_KEY =
ODOO_URL =
ODOO_DB =
ODOO_USERNAME =
#### Odoo project ids for worktime -> timesheet mapping.
#### Field Service project (Service worktime searches open tasks here; also excluded from Construction project search).
ODOO_FIELD_SERVICE_PROJECT_ID =
#### Dedicated Office project (all Office/desk worktime posts here, no task).
ODOO_OFFICE_PROJECT_ID =
#### How far (in months, +/- of today) the Service open-task deadline search reaches. Optional, default 6.
ODOO_TASK_WINDOW_MONTHS = 6
#### Optional: the bot's own Odoo user id. Inbound webhooks whose write_uid matches are skipped as echoes (saves an API pull). Idempotent reconcile also catches echoes if unset.
ODOO_BOT_UID =
#### Many2one Studio field on account.analytic.line linking a timesheet to its hr.attendance (shift).
#### Required (via Odoo Studio) for deletion support + attributing Odoo-created timesheets. Default x_studio_shift.
ODOO_SHIFT_FIELD = x_studio_shift
#### Optional: override hr.employee field names for the demographic pull (name/phone/address, Odoo -> bot).
#### Defaults are the standard Odoo 19 "private" contact fields. Uncomment + change only if yours differ,
#### and add the same field to the hr.employee automation's Watched Fields. (name is always "name".)
# ODOO_EMPLOYEE_PHONE_FIELD = private_phone
# ODOO_EMPLOYEE_STREET_FIELD = private_street
# ODOO_EMPLOYEE_STREET2_FIELD = private_street2
# ODOO_EMPLOYEE_CITY_FIELD = private_city
# ODOO_EMPLOYEE_STATE_FIELD = private_state_id
# ODOO_EMPLOYEE_ZIP_FIELD = private_zip
#### Set debugging to true or any value for true and leave empty for false
DEBUGGING = 
#Timecard Settings (all are required or none of them)
COMPANY_NAME = 
TIMECARD_LOG_ID = 
TIMECARD_REPORTS_CHANNEL_ID = 
TIMECARD_ADMIN_CHANNEL_ID = 
TIMECARD_TIMECLOCK_ROLE_ID = 
TIMECARD_ADMIN_ROLE = 
# Tik Tok Bot configuration (all are required or none of them)
TIKTOK_CLIENT_ID = 
TIKTOK_CLIENT_SECRET = 
# Twitch Bot configuration (all are required or none of them)
TWITCH_TOKEN = 
TWITCH_CLIENT_ID = 
TWITCH_CLIENT_SECRET = 